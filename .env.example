# Supabase is required for production login/registration and cloud persistence.
# Local demo fallback is available only when running Next.js in development mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin for email confirmation/password recovery (must be in Supabase Redirect URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Python vision service. Keep the API key identical in both terminals.
VISION_SERVICE_URL=http://127.0.0.1:8000
VISION_API_KEY=replace-with-a-long-random-value
VISION_MAX_UPLOAD_MB=25
VISION_PROXY_MAX_UPLOAD_MB=4
VISION_REQUEST_TIMEOUT_MS=170000

# Web v3 Team Control Center — server-only values. Never use NEXT_PUBLIC_ here.
# Empty allowlist = no admins. Use confirmed Supabase Auth user UUIDs.
CREDISAFE_ADMIN_USER_IDS=
CREDISAFE_ADMIN_REQUIRE_MFA=true
# Same cryptographically random >=32-byte secret as the Render backend.
CREDISAFE_ADMIN_BRIDGE_SECRET=
